<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Вход через Apple обязателен там, где есть вход через Google и Яндекс
	     (App Store Guideline 4.8), и системное окно спрашивается только с этим
	     разрешением. -->
	<!-- Пуши: сборка для TestFlight и App Store работает с боевым APNs. -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
